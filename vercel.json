{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/image.js": {
      "includeFiles": "assets/images/**",
      "memory": 1024,
      "maxDuration": 30
    },
    "api/upload.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/assets/images/(upload-.*)", "destination": "/api/image?id=$1" },
    { "source": "/protherme/assets/images/(upload-.*)", "destination": "/api/image?id=$1" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/protherme/admin", "destination": "/admin.html" },
    { "source": "/protherme", "destination": "/index.html" },
    { "source": "/protherme/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/download/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(admin|admin.html|protherme/admin)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/((?!api|admin|protherme/admin).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
