{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/video.js": {
      "includeFiles": "assets/videos/**",
      "maxDuration": 30
    },
    "api/image.js": {
      "includeFiles": "assets/**",
      "memory": 1024,
      "maxDuration": 30
    },
    "api/upload.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/assets/images/(upload-.*)", "destination": "/api/image?id=$1" },
    { "source": "/assets/videos/(.*)", "destination": "/api/image?id=$1" },
    { "source": "/protherme/assets/images/(upload-.*)", "destination": "/api/image?id=$1" },
    { "source": "/protherme/assets/videos/(.*)", "destination": "/api/image?id=$1" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/protherme/admin", "destination": "/admin.html" },
    { "source": "/protherme", "destination": "/index.html" },
    { "source": "/protherme/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
